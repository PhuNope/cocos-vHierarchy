{
  "name": "cocos-vhierarchy",
  "title": "vHierarchy",
  "version": "0.1.0",
  "package_version": 2,
  "description": "Unity-inspired custom Hierarchy for Cocos Creator 3.8.2+",
  "author": "PhuNope",
  "editor": ">=3.8.2",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "pack:local": "node scripts/package.cjs"
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.panel/vHierarchy",
        "label": "Settings / Palette",
        "message": "open-settings"
      },
      {
        "path": "i18n:menu.panel/vHierarchy",
        "label": "Enable / Disable",
        "message": "toggle-enabled"
      },
      {
        "path": "i18n:menu.panel/vHierarchy",
        "label": "Refresh Hierarchy",
        "message": "refresh"
      },
      {
        "path": "i18n:menu.panel/vHierarchy",
        "label": "Diagnostics",
        "message": "diagnostics"
      }
    ],
    "messages": {
      "open-settings": {
        "methods": [
          "openSettings"
        ]
      },
      "toggle-enabled": {
        "methods": [
          "toggleEnabled"
        ]
      },
      "refresh": {
        "methods": [
          "refresh"
        ]
      },
      "diagnostics": {
        "methods": [
          "diagnostics"
        ]
      },
      "get-state": {
        "methods": [
          "getState"
        ]
      },
      "set-option": {
        "methods": [
          "setOption"
        ]
      },
      "set-appearance": {
        "methods": [
          "setAppearance"
        ]
      },
      "toggle-bookmark": {
        "methods": [
          "toggleBookmark"
        ]
      }
    }
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}

  "compilerOptions": {
    "target": "ES2020", "module": "commonjs", "moduleResolution": "node",
    "strict": true, "lib": ["ES2020"], "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true, "esModuleInterop": true, "noEmitOnError": true
  },
  "include": ["src/core/**/*.ts", "src/main.ts"]
}
